# Postgres connection string. This is what the game itself runs on.
#
# Local (docker compose up -d):
DATABASE_URL=postgresql://clickrush:clickrush@localhost:5432/clickrush
#
# Supabase: Project Settings -> Database -> Connection string -> Transaction
# pooler (port 6543). Use the pooler, not the direct 5432 host: serverless
# functions open a connection per instance and will exhaust the direct limit.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#
# Any other host (Neon / RDS) works too. TLS turns on automatically off-localhost.
# DATABASE_URL=postgresql://user:password@host.neon.tech/clickrush?sslmode=require

# Force TLS on or off. Leave unset: local hosts skip TLS, everything else uses it.
# DATABASE_SSL=true

# Signing key for session JWTs. Must be at least 32 characters.
# Generate one with: openssl rand -base64 32
# Keep the real value in .env.local and in the host's environment variables,
# never here: this file is committed, and anyone holding this key can forge a
# session token for any account.
AUTH_SECRET=replace-me-with-openssl-rand-base64-32-output

# Absolute origin of the deployment, used to resolve link previews.
# NEXT_PUBLIC_SITE_URL=https://clickrush.vercel.app

# --- Supabase ---------------------------------------------------------------
# Only needed for Supabase features reached through src/utils/supabase. The
# game's own reads and writes go through DATABASE_URL above.

# Safe in the browser: NEXT_PUBLIC_ inlines these into the client bundle, and
# the publishable key is constrained by row-level security.
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server only. The secret key bypasses row-level security. Never give it a
# NEXT_PUBLIC_ prefix and never commit a real value.
# SUPABASE_SECRET_KEY=sb_secret_...
# SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
